# ════════════════════════════════════════════════
# DSGVO-Audit Pro - Umgebungsvariablen
# Kopieren Sie diese Datei als .env und füllen Sie
# die Werte aus.
# ════════════════════════════════════════════════

# Datenbank
DB_PASSWORD=ihr_sicheres_passwort_hier

# Redis
REDIS_PASSWORD=ihr_redis_passwort

# JWT Secret (mindestens 32 Zeichen, zufällig)
SECRET_KEY=ihr_sehr_langer_und_zufaelliger_secret_key_hier

# ─── KI-Integration ──────────────────────────────
# Claude API Key von Anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# ─── Stripe (Zahlungen) ──────────────────────────
# Stripe Dashboard: https://dashboard.stripe.com
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── CORS ────────────────────────────────────────
# Komma-getrennte Liste der erlaubten Origins
ALLOWED_ORIGINS=https://ihre-domain.de,https://app.ihre-domain.de

# ─── Optional: E-Mail ────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@ihre-domain.de
SMTP_PASSWORD=ihr_app_passwort

# ─── App-URL ─────────────────────────────────────
APP_URL=https://app.ihre-domain.de
